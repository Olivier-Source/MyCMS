# Settings for docker compose (copy to .env.docker and fill in)

# php artisan key:generate --show  (never change it afterwards: it encrypts messages and 2FA secrets)
APP_KEY=
APP_URL=https://example.com
# Optional: administration on a dedicated sub-domain (admin.example.com)
ADMIN_DOMAIN=

MYCMS_SITE_NAME="My Website"
MYCMS_LOCALE=en
MYCMS_PORT=8080

# First administrator (created at the first start)
MYCMS_ADMIN_EMAIL=
MYCMS_ADMIN_PASSWORD=

DB_DATABASE=mycms
DB_USERNAME=mycms
DB_PASSWORD=
DB_ROOT_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@example.com
