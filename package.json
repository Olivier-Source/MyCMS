{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build && npm run build:themes",
        "build:themes": "vite build -c vite.theme.config.js --mode default && vite build -c vite.theme.config.js --mode minimal",
        "dev": "vite",
        "dev:theme": "vite build -c vite.theme.config.js --mode default --watch"
    },
    "devDependencies": {
        "@alpinejs/focus": "^3.17.4",
        "@alpinejs/sort": "^3.17.4",
        "@fontsource-variable/literata": "^5.3.0",
        "@fontsource-variable/nunito-sans": "^5.3.0",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.17.4",
        "concurrently": "^10.0.3",
        "laravel-vite-plugin": "^3.1",
        "tailwindcss": "^4.0.0",
        "trix": "^2.1.19",
        "vite": "^8.0.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1"
    }
}
